diff --git a/Server.Medius/StatusApi.cs b/Server.Medius/StatusApi.cs
new file mode 100644
index 0000000..acb451d
--- /dev/null
+++ b/Server.Medius/StatusApi.cs
@@ -0,0 +1,94 @@
+using Newtonsoft.Json;
+using System;
+using System.Linq;
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Server.Medius
+{
+    /// <summary>
+    /// Minimal read-only HTTP endpoint (GET /status) used by the HSG6 admin page.
+    /// Plain TcpListener so no URL ACL / admin rights are needed. Localhost only.
+    /// </summary>
+    public static class StatusApi
+    {
+        public static void Start(int port)
+        {
+            var listener = new TcpListener(IPAddress.Loopback, port);
+            listener.Start();
+            Task.Run(async () =>
+            {
+                while (true)
+                {
+                    TcpClient c = null;
+                    try
+                    {
+                        c = await listener.AcceptTcpClientAsync();
+                        _ = Task.Run(() => Serve(c));
+                    }
+                    catch
+                    {
+                        c?.Dispose();
+                    }
+                }
+            });
+        }
+
+        static void Serve(TcpClient c)
+        {
+            using (c)
+            using (var s = c.GetStream())
+            {
+                s.ReadTimeout = 2000;
+                var buf = new byte[4096];
+                try { s.Read(buf, 0, buf.Length); } catch { return; }
+
+                byte[] body;
+                try { body = Encoding.UTF8.GetBytes(JsonConvert.SerializeObject(Snapshot(), Formatting.Indented)); }
+                catch (Exception e) { body = Encoding.UTF8.GetBytes(JsonConvert.SerializeObject(new { error = e.Message })); }
+
+                var head = Encoding.ASCII.GetBytes(
+                    "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nConnection: close\r\n" +
+                    $"Content-Length: {body.Length}\r\n\r\n");
+                s.Write(head, 0, head.Length);
+                s.Write(body, 0, body.Length);
+            }
+        }
+
+        static object Snapshot()
+        {
+            var clients = Program.Manager.GetAllClients();
+            var games = Program.Manager.GetAllGames();
+            return new
+            {
+                time = DateTime.UtcNow,
+                clients = clients.Select(x => new
+                {
+                    accountId = x.AccountId,
+                    name = x.AccountName,
+                    appId = x.ApplicationId,
+                    connected = x.IsConnected,
+                    loggedIn = x.IsLoggedIn,
+                    channelId = x.CurrentChannel?.Id,
+                    gameId = x.CurrentGame?.Id,
+                    gameName = x.CurrentGame?.GameName,
+                }).ToList(),
+                games = games.Select(g => new
+                {
+                    id = g.Id,
+                    name = g.GameName,
+                    appId = g.ApplicationId,
+                    status = g.WorldStatus.ToString(),
+                    playerCount = g.PlayerCount,
+                    maxPlayers = g.MaxPlayers,
+                    host = g.Host?.AccountName,
+                    created = g.UtcTimeCreated,
+                    players = g.Clients.Where(p => p?.Client != null && p.InGame).Select(p => p.Client.AccountName).ToList(),
+                }).ToList(),
+            };
+        }
+    }
+}
